import { useEffect, useState } from "react";
import { useNavigate, useParams } from "react-router-dom";

const Issue = () => {
  const { id } = useParams();
  const navigate = useNavigate();

  const [issue, setIssue] = useState(null);

  // Update ke liye states
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [status, setStatus] = useState("open");

  // Issue fetch karna
  const fetchIssue = async () => {
    try {
      const response = await fetch(
        `http://localhost:3000/issue/${id}`
      );

      const data = await response.json();

      console.log("ISSUE:", data);

      setIssue(data.issue);

      // Update inputs me current issue ki values
      setTitle(data.issue.title);
      setDescription(data.issue.description || "");
      setStatus(data.issue.status);
    } catch (err) {
      console.error("Error while fetching issue:", err);
    }
  };

  useEffect(() => {
    fetchIssue();
  }, [id]);

  // Update Issue
  const updateIssue = async () => {
    try {
      const response = await fetch(
        `http://localhost:3000/issue/updated/${id}`,
        {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            title,
            description,
            status,
          }),
        }
      );

      const data = await response.json();

      console.log("UPDATED ISSUE:", data);

      setIssue(data);

      alert("Issue updated successfully!");
    } catch (err) {
      console.error("Error while updating issue:", err);
    }
  };

  // Delete Issue
  const deleteIssue = async () => {
    try {
      const response = await fetch(
        `http://localhost:3000/issue/delete/${id}`,
        {
          method: "DELETE",
        }
      );

      const data = await response.json();

      console.log("DELETED ISSUE:", data);

      alert("Issue deleted successfully!");

      // Delete hone ke baad repository page par
      navigate(-1);
    } catch (err) {
      console.error("Error while deleting issue:", err);
    }
  };

  if (!issue) {
    return <h2>Loading...</h2>;
  }

  return (
    <div>
      <h1>Issue Details</h1>

      {/* Issue Title */}
      <input
        type="text"
        value={title}
        onChange={(e) => setTitle(e.target.value)}
      />

      <br />
      <br />

      {/* Issue Description */}
      <textarea
        value={description}
        onChange={(e) => setDescription(e.target.value)}
      />

      <br />
      <br />

      {/* Issue Status */}
      <select
        value={status}
        onChange={(e) => setStatus(e.target.value)}
      >
        <option value="open">Open</option>
        <option value="closed">Closed</option>
      </select>

      <br />
      <br />

      {/* Buttons */}
      <button onClick={updateIssue}>
        Update Issue
      </button>

      <button onClick={deleteIssue}>
        Delete Issue
      </button>
    </div>
  );
};

export default Issue;





